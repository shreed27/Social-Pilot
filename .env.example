# ── Core ─────────────────────────────────────────────
MODE=dry_run                 # dry_run = nothing is posted, mock IDs returned | live = real API calls
LLM_PROVIDER=anthropic       # anthropic | mock (mock = offline canned output, for tests)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///data/socialpilot.db
DASHBOARD_PASSWORD=change-me

# Media must be reachable on a public URL for Instagram to fetch it
# (use an S3/R2 bucket, or ngrok/cloudflared pointing at this app's /media route)
PUBLIC_MEDIA_BASE_URL=https://your-public-host.example.com/media

# AI video + images via kie.ai (the API behind the Open-Higgsfield-AI studio). Paid per generation:
# veo3_fast ≈ $0.40 per 8 s clip; Nano Banana image ≈ $0.04. Blank key = text-motion reels, flat covers.
KIE_API_KEY=
KIE_VIDEO_MODEL=veo3_fast
KIE_IMAGE_MODEL=nano-banana-2
KIE_CLIPS_PER_REEL=2
KIE_KEEP_AUDIO=false
KIE_DAILY_BUDGET_USD=3.00
KIE_AI_COVERS=true

# Cadence and autonomy
PLAN_DAYS_AHEAD=2
AUTO_APPROVE_MIN_SCORE=0        # 0 = every post waits for you. e.g. 9.0 = auto-approve drafts that pass every gate with viral ≥ 9

# Optional AI image backgrounds via OpenAI (used only if KIE_API_KEY is blank)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# Optional: let the research agent use Claude's web search tool in addition to RSS
RESEARCH_WEB_SEARCH=false
WEB_SEARCH_TOOL_TYPE=web_search_20250305

# Optional: xbird, read-only X research (what's getting engagement in your niche this week).
# Runs `npx @checkra1n/xbird` with YOUR x.com browser session and pays per call in USDC from a wallet
# it creates (fund it first). Unofficial: X's terms don't allow cookie-based automation, so this
# integration only ever calls search/read tools, capped per run and per day.
XBIRD_ENABLED=false
XBIRD_COMMAND=npx -y @checkra1n/xbird
XBIRD_MAX_CALLS_PER_RUN=4
XBIRD_DAILY_BUDGET_USD=1.00
XBIRD_MIN_LIKES=200
XBIRD_LOOKBACK_DAYS=7

# Quality gate
CRITIC_MIN_SCORE=8.0      # viral-potential bar a draft must clear
MAX_REVISIONS=2

# Slack: daily report + alerts in a channel. Create an app at api.slack.com/apps → Incoming Webhooks →
# "Add New Webhook to Workspace", pick the channel, paste the URL here.
SLACK_WEBHOOK_URL=
SLACK_DIGEST_TIME=21:00
SLACK_NOTIFY_DRAFTS=true
DASHBOARD_URL=

# Notifications when drafts are waiting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Instagram (Graph API, professional account linked to a FB Page) ──
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=https://graph.facebook.com
IG_API_VERSION=v26.0

# ── LinkedIn (Community Management API, company page) ──
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202610

# ── X (pay-per-use API, OAuth 2.0 user token with tweet.write) ──
X_ACCESS_TOKEN=
X_USER_ID=
